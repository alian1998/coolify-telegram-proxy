# Public IP of the Coolify VPS (shown in the dashboard list)
PROXY_PUBLIC_HOST=88.222.213.240

# Host ports Coolify/VPS will publish
HTTP_PUBLISH_PORT=8080
SOCKS_PUBLISH_PORT=1080
DASHBOARD_PUBLISH_PORT=3000

# Proxy login (letters, numbers, dot, underscore, hyphen only)
PROXY_USERNAME=tgproxy
PROXY_PASSWORD=change-this-proxy-pass

# Optional extra users: user2:pass2,user3:pass3
PROXY_USERS=

# Dashboard login (required)
DASHBOARD_PASSWORD=change-this-dashboard-pass
SESSION_SECRET=change-this-long-random-string

# Optional label in the list (e.g. US, DE, BD)
PROXY_COUNTRY=

MAXCONN=200
